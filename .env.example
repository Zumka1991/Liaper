# Скопируйте в .env и задайте собственные значения. Файл .env не коммитится.
# Секреты генерируются, например: openssl rand -base64 48

# --- Публичный адрес (для docker compose --profile tls) ---
# Домен, на который указывает DNS. Caddy автоматически выпустит TLS-сертификат.
LIAPER_DOMAIN=lessons.example.com
# Разрешённые источники браузерных запросов (CORS), через запятую.
LIAPER_ALLOWED_ORIGINS=https://lessons.example.com,tauri://localhost,http://tauri.localhost
# Число своих прокси перед сервером управления — для лимитов по IP.
# 2 при запуске с Caddy (--profile tls), 1 — если перед сервером только nginx из контейнера web.
LIAPER_TRUSTED_PROXY_HOPS=2

# --- PostgreSQL ---
POSTGRES_USER=liaper
POSTGRES_PASSWORD=
POSTGRES_DB=liaper

# --- Секреты сервисов (каждый не короче 32 символов) ---
# Подпись допусков к файловой ноде.
LIAPER_STORAGE_SECRET=
# Подпись heartbeat медиа-нод и допусков в медиа-комнаты. Без него ноды работают в режиме разработки.
LIAPER_NODE_SECRET=

# --- Администрирование ---
# Ники владельцев админки через запятую. Без значения админка выключена.
LIAPER_ADMIN_USERNAMES=
# Мастер-пароль админки (>= 12 символов). Можно не задавать и установить при первом входе в админку.
LIAPER_ADMIN_PASSWORD=
# Ключ публикации релизов через API. Без значения публикация выключена.
LIAPER_ADMIN_SECRET=

# --- Адреса, которые получают клиенты ---
# Без TLS-профиля: http://<host>:4201, ws://<host>:4101/ws/sfu
FILE_NODE_PUBLIC_URL=https://lessons.example.com/files
NODE_1_WS_URL=wss://lessons.example.com/sfu/1/ws/sfu
NODE_2_WS_URL=wss://lessons.example.com/sfu/2/ws/sfu

# --- TURN (рекомендуется для пользователей за NAT) ---
LIAPER_TURN_URL=
LIAPER_TURN_USER=
LIAPER_TURN_PASS=

# --- Push о входящих звонках (Android, Firebase Cloud Messaging) ---
# Положите ключ сервисного аккаунта Firebase в ./secrets/fcm-service-account.json
# (Firebase Console → Project settings → Service accounts). Без файла push выключен.
# FCM_SERVICE_ACCOUNT_FILE=/app/secrets/fcm-service-account.json

# Сборка Web: пусто — API на том же домене.
VITE_CONTROL_URL=
