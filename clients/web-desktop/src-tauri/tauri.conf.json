{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liaper",
  "version": "0.1.0",
  "identifier": "com.liaper.tutoring",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liaper — Защищённая платформа для репетиторства (E2EE)",
        "width": 1360,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "http://127.0.0.1:4000/api/releases/tauri/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IExJQVBFUi1FRDI1NTE5LVBVQktFWQ=="
    }
  }
}
