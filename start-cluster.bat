@echo off
if not exist "target\debug\liaper-control.exe" (
  echo Building Rust binaries...
  cargo build --workspace
)
echo [1/5] Starting Liaper Control Server on http://127.0.0.1:4000 ...
start "Liaper Control Server" cmd /k "target\debug\liaper-control.exe"
ping 127.0.0.1 -n 2 >nul
echo [2/5] Starting Liaper SFU Media Node #1 on port 4101 ...
start "Liaper SFU Node 1" cmd /k "set NODE_PORT=4101&& set NODE_ID=node-ru-1&& set NODE_NAME=SFU-Node-1-Moscow&& set NODE_REGION=RU-Central&& target\debug\liaper-node.exe"
echo [3/5] Starting Liaper SFU Media Node #2 on port 4102 ...
start "Liaper SFU Node 2" cmd /k "set NODE_PORT=4102&& set NODE_ID=node-ru-2&& set NODE_NAME=SFU-Node-2-Siberia&& set NODE_REGION=RU-East&& target\debug\liaper-node.exe"
echo [4/5] Starting Liaper Web/Desktop UI on http://localhost:5173 ...
start "Liaper Web UI" cmd /k "cd /d clients\web-desktop && npm.cmd run dev"
echo [5/5] Forwarding USB ports to Android phone via ADB (if connected) ...
start "Liaper ADB USB Bridge" cmd /k "adb reverse tcp:4000 tcp:4000 && adb reverse tcp:4101 tcp:4101 && adb reverse tcp:4102 tcp:4102 && adb reverse tcp:5173 tcp:5173 && echo USB ports 4000, 4101, 4102, 5173 forwarded to phone!"
echo.
echo Liaper cluster started! Open in browser: http://localhost:5173