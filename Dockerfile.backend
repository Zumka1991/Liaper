FROM rust:1.95-bookworm AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docker ./docker

RUN cargo build --release --workspace

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/target/release/liaper-control /usr/local/bin/liaper-control
COPY --from=builder /build/target/release/liaper-node /usr/local/bin/liaper-node
COPY --from=builder /build/target/release/liaper-files /usr/local/bin/liaper-files

# Сервисы работают без root. Для bind-mount на Linux: sudo chown -R 10001:10001 data releases
RUN useradd --system --uid 10001 --home /app liaper \
    && mkdir -p /app/data /app/releases \
    && chown -R liaper:liaper /app
USER liaper

EXPOSE 4000 4101 4102 4201

CMD ["liaper-control"]
